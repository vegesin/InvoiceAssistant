    "mailparser": "^3.7.1",
    "onnxruntime-node": "1.22.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "sharp": "0.34.5",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
